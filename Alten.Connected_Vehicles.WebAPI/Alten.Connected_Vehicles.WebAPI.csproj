<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Alten.Connected_Vehicles.WebAPI</RootNamespace>
    <AssemblyName>Alten.Connected_Vehicles.WebAPI</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alten.Connected_vehicle.Model\Alten.Connected_vehicle.Model.csproj" />
    <ProjectReference Include="..\Alten.Connected_Vehicles.BLL\Alten.Connected_Vehicles.BLL.csproj" />
    <ProjectReference Include="..\Alten.Connected_Vehicles.DTO\Alten.Connected_Vehicles.DTO.csproj" />
    <ProjectReference Include="..\Alten.Connected_Vehicles.Infrastructure\Alten.Connected_Vehicles.Infrastructure.csproj" />
    <ProjectReference Include="..\Alten.Connected_Vehicles.MSSQLRepository\Alten.Connected_Vehicles.MSSQLRepository.csproj" />
  </ItemGroup>

  <!-- Exclude old ASP.NET files from compilation -->
  <ItemGroup>
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="App_Start\**" />
    <Content Remove="Global.asax" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <Content Remove="ApplicationInsights.config" />
  </ItemGroup>
</Project>
